  <property name="styleSheet">
   <string notr="true">
QMainWindow, QWidget {
    background: #f5f8fc;
    color: #172033;
    font-family: &quot;Microsoft YaHei UI&quot;;
    font-size: 10pt;
}
QFrame#sidebarFrame { background: #f8fbff; border-right: 1px solid #dce6f2; }
QFrame#headerFrame { background: white; border-bottom: 1px solid #dce6f2; }
QFrame[card=&quot;true&quot;] { background: white; border: 1px solid #d9e4f2; border-radius: 10px; }
QFrame#imageCard1, QFrame#imageCard2, QFrame#imageCard3, QFrame#imageCard4, QFrame#imageCard5,
QFrame#bareProductCard, QFrame#normalPackageCard, QFrame#conservativePackageCard,
QFrame#forwarderCardShenzhen, QFrame#forwarderCardYiwu {
    background: #fbfdff; border: 1px solid #dbe5f1; border-radius: 8px;
}
QLabel[sectionTitle=&quot;true&quot;] { font-size: 12pt; font-weight: 700; color: #172033; }
QLabel#lblGreetingTitle { font-size: 16pt; font-weight: 700; }
QLabel#lblGreetingSubtitle, QLabel[hint=&quot;true&quot;] { color: #738198; font-size: 9pt; }
QPushButton { background: white; border: 1px solid #d7e2ef; border-radius: 7px; padding: 6px 12px; }
QPushButton:hover { border-color: #4083ff; color: #1767e8; }
QPushButton[primary=&quot;true&quot;] { background: #176ff2; color: white; border-color: #176ff2; font-weight: 600; }
QPushButton[navActive=&quot;true&quot;] { background: #eaf2ff; color: #176ff2; border: none; text-align: left; font-weight: 600; }
QPushButton[navItem=&quot;true&quot;] { background: transparent; border: none; text-align: left; padding: 10px 12px; }
QLineEdit, QComboBox, QDoubleSpinBox { background: white; border: 1px solid #d7e2ef; border-radius: 6px; padding: 5px 8px; min-height: 24px; }
QLineEdit[preview=&quot;true&quot;], QDoubleSpinBox[preview=&quot;true&quot;] { background: #f1f5fa; color: #607089; }
QLabel[dropZone=&quot;true&quot;] { background: #fbfdff; border: 1px dashed #c9d7e8; border-radius: 7px; color: #42526a; }
QFrame#normalPackageCard[selected=&quot;true&quot;], QFrame#forwarderCardShenzhen[selected=&quot;true&quot;] { border: 2px solid #4d8dff; background: #f7fbff; }
QLabel#lblSubsidyStatus { background: #ecfff4; color: #1b9a5a; border: 1px solid #bdebd1; border-radius: 6px; padding: 6px 10px; font-weight: 600; }
QLabel#lblSaveStatus { background: #fff4df; color: #e27c12; border-radius: 6px; padding: 5px 10px; }
QLabel[logoBadge=&quot;true&quot;], QLabel[userBadge=&quot;true&quot;] { background: #176ff2; color: white; border-radius: 8px; font-weight: 700; }
QLabel[totalValue=&quot;true&quot;] { color: #176ff2; font-weight: 700; }
QLabel[statusOk=&quot;true&quot;] { color: #1b9a5a; font-weight: 600; }
QLabel[conclusion=&quot;true&quot;] { background: #eef5ff; border: 1px solid #cfe0f7; border-radius: 6px; padding: 7px; color: #33445d; }
QSplitter::handle { background: #edf2f8; width: 6px; }
QScrollArea { border: none; background: transparent; }
QScrollBar:vertical { width: 10px; background: transparent; }
QScrollBar::handle:vertical { background: #c8d5e5; border-radius: 5px; min-height: 30px; }

QWidget[unitField=&quot;true&quot;] { background: transparent; }
QLabel[unitLabel=&quot;true&quot;] { background: transparent; color: #607089; padding: 0 2px; }


/* Approved middle-section reference */
QFrame#costPackingSection, QFrame#freightSection, QFrame#systemCostSection {
    font-size: 9pt;
}
QFrame#costPackingSection QLabel[sectionTitle=&quot;true&quot;],
QFrame#freightSection QLabel[sectionTitle=&quot;true&quot;],
QFrame#systemCostSection QLabel[sectionTitle=&quot;true&quot;] {
    font-size: 11pt;
}
QFrame#costPackingSection QLineEdit,
QFrame#costPackingSection QDoubleSpinBox,
QFrame#freightSection QDoubleSpinBox {
    padding: 3px 5px;
    min-height: 20px;
}
QFrame#costPackingSection QWidget[unitField=&quot;true&quot;] QDoubleSpinBox,
QFrame#freightSection QWidget[unitField=&quot;true&quot;] QDoubleSpinBox {
    padding: 3px 1px 3px 4px;
}
QFrame#costPackingSection QWidget[unitField=&quot;true&quot;] QLabel[unitLabel=&quot;true&quot;],
QFrame#freightSection QWidget[unitField=&quot;true&quot;] QLabel[unitLabel=&quot;true&quot;] {
    padding: 0 3px 0 1px;
}
QFrame#costPackingSection QLabel#lblBareLengthCm,
QFrame#costPackingSection QLabel#lblBareWidthCm,
QFrame#costPackingSection QLabel#lblBareHeightCm,
QFrame#costPackingSection QLabel#lblNormalLengthCm,
QFrame#costPackingSection QLabel#lblNormalWidthCm,
QFrame#costPackingSection QLabel#lblNormalHeightCm,
QFrame#costPackingSection QLabel#lblConservativeLengthCm,
QFrame#costPackingSection QLabel#lblConservativeWidthCm,
QFrame#costPackingSection QLabel#lblConservativeHeightCm {
    color: #55657b;
    padding-left: 3px;
}
</string>
