  <property name="styleSheet">
   <string>QMainWindow,QWidget{background:#f5f8fc;color:#172033;font-family:"Microsoft YaHei UI";font-size:9pt;}
QFrame[section="true"]{background:white;border:1px solid #dbe5f1;border-radius:6px;}
QFrame[section="false"]{background:transparent;border:none;}
QLabel[title="true"]{font-weight:600;} QLabel[unit="true"]{color:#607089;} QLabel[status="true"]{font-size:8pt;color:#607089;}
QDoubleSpinBox{background:white;border:1px solid #c5d5e8;border-radius:4px;padding:2px 4px;min-height:24px;}
QDoubleSpinBox:focus{border:1px solid #176ff2;}
QDoubleSpinBox[preview="true"]{background:#f1f5fa;border:1px solid #e0e7f1;color:#5a6478;}
QDoubleSpinBox[preview="true"]:focus{border:1px solid #c5d1e0;}
QComboBox{background:white;border:1px solid #d7e2ef;border-radius:4px;padding:2px 4px;min-height:24px;}
QComboBox:focus{border:1px solid #176ff2;}
QToolButton,QPushButton{background:white;border:1px solid #d7e2ef;border-radius:4px;padding:3px 6px;min-height:24px;}
QToolButton[selected="true"]{background:#176ff2;color:white;border-color:#176ff2;font-weight:600;}
QCheckBox{background:transparent;color:#172033;}</string>
