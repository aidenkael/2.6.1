  <property name="styleSheet">
   <string notr="true">
QMainWindow, QWidget {
    background: #f5f8fc;
    color: #172033;
    font-family: "Microsoft YaHei UI";
    font-size: 10pt;
}
QFrame#sidebarFrame { background: #f8fbff; border-right: 1px solid #dce6f2; }
QFrame#headerFrame { background: white; border-bottom: 1px solid #dce6f2; }
QFrame[card="true"] { background: white; border: 1px solid #d9e4f2; border-radius: 10px; }
QFrame#imageCard1, QFrame#imageCard2, QFrame#imageCard3, QFrame#imageCard4, QFrame#imageCard5,
QFrame#bareProductCard, QFrame#normalPackageCard, QFrame#conservativePackageCard,
QFrame#forwarderCardShenzhen, QFrame#forwarderCardYiwu {
    background: #fbfdff; border: 1px solid #dbe5f1; border-radius: 8px;
}
QLabel[sectionTitle="true"] { font-size: 12pt; font-weight: 700; color: #172033; }
QLabel#lblGreetingTitle { font-size: 11pt; }
QLabel#lblGreetingHi { font-family: "Segoe UI Semibold", "Microsoft YaHei UI"; font-size: 15pt; font-weight: 600; color: #172033; }
QLabel#lblGreetingUserName { background: #176ff2; color: white; border-radius: 8px; padding: 4px 14px; font-weight: 600; font-size: 11pt; }
QLabel#lblGreetingSubtitle, QLabel[hint="true"] { color: #738198; font-size: 9pt; }
QPushButton { background: white; border: 1px solid #d7e2ef; border-radius: 7px; padding: 6px 12px; }
QPushButton:hover { border-color: #4083ff; color: #1767e8; }
QPushButton[primary="true"] { background: #176ff2; color: white; border-color: #176ff2; font-weight: 600; }
QPushButton[navActive="true"] { background: #eaf2ff; color: #176ff2; border: none; text-align: left; font-weight: 600; }
QPushButton[navItem="true"] { background: transparent; border: none; text-align: left; padding: 10px 12px; }
QLineEdit, QTextEdit, QComboBox, QDoubleSpinBox { background: white; border: 1px solid #d7e2ef; border-radius: 6px; padding: 5px 8px; min-height: 24px; }
QLineEdit[preview="true"], QTextEdit[preview="true"], QDoubleSpinBox[preview="true"], QLabel[preview="true"] { background: #f1f5fa; color: #607089; }
QLabel[dropZone="true"] { background: #fbfdff; border: 1px dashed #c9d7e8; border-radius: 7px; color: #42526a; }
QFrame#normalPackageCard[selected="true"], QFrame#forwarderCardShenzhen[selected="true"] { border: 2px solid #4d8dff; background: #f7fbff; }
QLabel#lblSubsidyStatus { background: #ecfff4; color: #1b9a5a; border: 1px solid #bdebd1; border-radius: 6px; padding: 6px 10px; font-weight: 600; }
QLabel#lblSaveStatus { background: #fff4df; color: #e27c12; border-radius: 6px; padding: 5px 10px; }
QLabel[logoBadge="true"] { background: #176ff2; color: white; border-radius: 8px; font-weight: 700; }
QLabel[totalValue="true"] { color: #176ff2; font-weight: 700; }
QLabel[statusOk="true"] { color: #1b9a5a; font-weight: 600; }
QLabel[conclusion="true"] { background: #eef5ff; border: 1px solid #cfe0f7; border-radius: 6px; padding: 7px; color: #33445d; }
QSplitter::handle { background: #edf2f8; width: 6px; }
QScrollArea { border: none; background: transparent; }
QScrollBar:vertical { width: 10px; background: transparent; }
QScrollBar::handle:vertical { background: #c8d5e5; border-radius: 5px; min-height: 30px; }

QWidget[unitField="true"] { background: transparent; }
QLabel[unitLabel="true"] { background: transparent; color: #607089; padding: 0 2px; }


/* Approved middle-section reference */
QFrame#costPackingSection, QFrame#freightSection, QFrame#tailSettingsCard, QFrame#systemCostSection {
    font-size: 9pt;
}
QFrame#costPackingSection QLabel[sectionTitle="true"],
QFrame#freightSection QLabel[sectionTitle="true"],
QFrame#tailSettingsCard QLabel[sectionTitle="true"],
QFrame#systemCostSection QLabel[sectionTitle="true"] {
    font-size: 11pt;
}
QFrame#costPackingSection QLineEdit,
QFrame#costPackingSection QDoubleSpinBox,
QFrame#freightSection QDoubleSpinBox,
QFrame#tailSettingsCard QDoubleSpinBox {
    padding: 3px 5px;
    min-height: 20px;
}
QFrame#costPackingSection QWidget[unitField="true"] QDoubleSpinBox,
QFrame#freightSection QWidget[unitField="true"] QDoubleSpinBox {
    padding: 3px 1px 3px 4px;
}
QFrame#costPackingSection QWidget[unitField="true"] QLabel[unitLabel="true"],
QFrame#freightSection QWidget[unitField="true"] QLabel[unitLabel="true"] {
    padding: 0 3px 0 1px;
}
QFrame#costPackingSection QLabel#lblBareLengthCm,
QFrame#costPackingSection QLabel#lblBareWidthCm,
QFrame#costPackingSection QLabel#lblBareHeightCm,
QFrame#costPackingSection QLabel#lblNormalLengthCm,
QFrame#costPackingSection QLabel#lblNormalWidthCm,
QFrame#costPackingSection QLabel#lblNormalHeightCm,
QFrame#costPackingSection QLabel#lblConservativeLengthCm,
QFrame#costPackingSection QLabel#lblConservativeWidthCm,
QFrame#costPackingSection QLabel#lblConservativeHeightCm {
    color: #55657b;
    padding-left: 3px;
}

/* 2026-08-04 frozen packaging contract */
QFrame#conservativePackageCard QLineEdit,
QFrame#conservativePackageCard QDoubleSpinBox,
QTextEdit#txtNormalReminder {
    background: #f1f5fa;
    color: #607089;
}
QFrame#conservativePackageCard QLabel { color: #55657b; }
</string>
