{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://profit-accounting.local/contracts/agent_calibration_rule_package_v1.schema.json",
  "title": "Agent Calibration Rule Package V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "package_id", "calibration_version", "created_at", "generator", "source_export_batch_ids", "base_engine_version", "status", "rules", "validation"],
  "properties": {
    "schema_version": {"const": "agent-calibration-rule-package-v1"},
    "package_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "calibration_version": {"type": "string", "minLength": 1, "maxLength": 128},
    "created_at": {"type": "string", "format": "date-time"},
    "generator": {"type": "string", "minLength": 1, "maxLength": 128},
    "source_export_batch_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
    "base_engine_version": {"type": "string", "minLength": 1, "maxLength": 128},
    "base_calibration_version": {"type": "string", "minLength": 1, "maxLength": 128},
    "status": {"enum": ["candidate", "validated"]},
    "rules": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/rule"}},
    "validation": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/validation"}]}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "candidate"}}, "required": ["status"]}, "then": {"properties": {"validation": {"type": "null"}}}},
    {"if": {"properties": {"status": {"const": "validated"}}, "required": ["status"]}, "then": {"properties": {"validation": {"$ref": "#/$defs/validation"}}}}
  ],
  "$defs": {
    "positiveNumber": {"type": "number", "exclusiveMinimum": 0},
    "nonNegativeNumber": {"type": "number", "minimum": 0},
    "dimensionTriple": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/positiveNumber"}},
    "nonEmptyStringArray": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "match": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "any_terms": {"$ref": "#/$defs/nonEmptyStringArray"},
        "materials": {"$ref": "#/$defs/nonEmptyStringArray"},
        "rigidity": {"$ref": "#/$defs/nonEmptyStringArray"},
        "foldability": {"$ref": "#/$defs/nonEmptyStringArray"},
        "compressibility": {"$ref": "#/$defs/nonEmptyStringArray"},
        "forbid_hard_structure": {"const": true},
        "requires_shape_retention": {"type": "boolean"}
      }
    },
    "guard": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "any_hard_structure_or_shape_retention": {"type": "boolean"},
        "foldability_not": {"$ref": "#/$defs/nonEmptyStringArray"}
      }
    },
    "actionSmallestAxisScale": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "normal", "conservative"],
      "properties": {"type": {"const": "smallest_axis_scale"}, "normal": {"$ref": "#/$defs/positiveNumber"}, "conservative": {"$ref": "#/$defs/positiveNumber"}, "min_cm": {"$ref": "#/$defs/positiveNumber"}}
    },
    "actionSmallestAxisAdd": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "normal_cm", "conservative_cm"],
      "properties": {"type": {"const": "smallest_axis_add"}, "normal_cm": {"$ref": "#/$defs/nonNegativeNumber"}, "conservative_cm": {"$ref": "#/$defs/nonNegativeNumber"}}
    },
    "actionVolumeRatio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "normal", "conservative"],
      "properties": {"type": {"const": "volume_ratio"}, "normal": {"$ref": "#/$defs/positiveNumber"}, "conservative": {"$ref": "#/$defs/positiveNumber"}}
    },
    "actionReferenceScaledTemplate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "reference_product_size_cm", "normal_package_size_cm", "conservative_package_size_cm"],
      "properties": {
        "type": {"const": "reference_scaled_template"},
        "reference_product_size_cm": {"$ref": "#/$defs/dimensionTriple"},
        "normal_package_size_cm": {"$ref": "#/$defs/dimensionTriple"},
        "conservative_package_size_cm": {"$ref": "#/$defs/dimensionTriple"},
        "scale_min": {"$ref": "#/$defs/positiveNumber"},
        "scale_max": {"$ref": "#/$defs/positiveNumber"}
      }
    },
    "action": {"oneOf": [{"$ref": "#/$defs/actionSmallestAxisScale"}, {"$ref": "#/$defs/actionSmallestAxisAdd"}, {"$ref": "#/$defs/actionVolumeRatio"}, {"$ref": "#/$defs/actionReferenceScaledTemplate"}]},
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_record_ids", "sample_count"],
      "properties": {
        "source_record_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
        "sample_count": {"type": "integer", "minimum": 1},
        "rationale": {"type": "string", "maxLength": 2000}
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "enabled", "priority", "match", "action", "evidence"],
      "properties": {
        "rule_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "enabled": {"type": "boolean"},
        "priority": {"type": "integer", "minimum": 0, "maximum": 100000},
        "description": {"type": "string", "maxLength": 2000},
        "match": {"$ref": "#/$defs/match"},
        "guard": {"$ref": "#/$defs/guard"},
        "action": {"$ref": "#/$defs/action"},
        "evidence": {"$ref": "#/$defs/evidence"}
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["validator", "replay_id", "engine_version", "total_records", "matched", "improved", "unchanged", "degraded", "conflicts"],
      "properties": {
        "validator": {"type": "string", "minLength": 1, "maxLength": 128},
        "replay_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "engine_version": {"type": "string", "minLength": 1, "maxLength": 128},
        "baseline_calibration_version": {"type": "string", "minLength": 1, "maxLength": 128},
        "total_records": {"type": "integer", "minimum": 0},
        "matched": {"type": "integer", "minimum": 0},
        "improved": {"type": "integer", "minimum": 0},
        "unchanged": {"type": "integer", "minimum": 0},
        "degraded": {"type": "integer", "minimum": 0},
        "conflicts": {"type": "integer", "minimum": 0}
      }
    }
  }
}
